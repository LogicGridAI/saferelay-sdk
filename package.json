{
  "name": "@logicgridai/safepaste-sdk",
  "version": "0.2.0",
  "description": "Zero-trust DLP SDK for React applications",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
