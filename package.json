    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^8.0.0"
  },
  "author": "LogicGrid AI LLC",
  "license": "PROPRIETARY",
